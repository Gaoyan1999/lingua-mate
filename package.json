{
  "name": "lingua-mate-skill",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --dir assets/vite-template dev",
    "build": "pnpm --dir assets/vite-template build",
    "split": "python3 scripts/split_transcription.py",
    "bilibili": "python3 scripts/download_bilibili.py",
    "fill": "python3 scripts/fill_lesson_with_codex.py",
    "translate": "python3 scripts/translate_chunks_with_codex.py --chunks ../test-lingua-mate/materials/s10e01/chunks.json",
    "enrich": "python3 scripts/enrich_lesson_with_codex.py",
    "apply:s10e01": "python3 scripts/apply_chunks_to_template.py --chunks ../test-lingua-mate/materials/s10e01/chunks.json --media ./S10E01.mp4 --lesson-out ../test-lingua-mate/materials/s10e01/lesson.json --lesson-id s10e01 --registry ../test-lingua-mate/registry.json --link-template",
    "transcript:s10e01": "python3 scripts/generate_transcript.py --chunks ../test-lingua-mate/materials/s10e01/chunks.json --prefix ../test-lingua-mate/materials/s10e01/transcript",
    "test": "python3 -m unittest discover -s tests",
    "template:install": "pnpm --dir assets/vite-template install"
  }
}
